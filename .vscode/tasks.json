{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Eco-Pantry: localhost",
      "type": "process",
      "command": "node",
      "args": ["scripts/serve.mjs", "--port", "5173"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "eco-pantry",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+): error (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Đang khởi động Eco-Pantry",
          "endsPattern": "^Local: http://localhost:5173$"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Eco-Pantry: build",
      "type": "process",
      "command": "node",
      "args": ["scripts/build.mjs"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
